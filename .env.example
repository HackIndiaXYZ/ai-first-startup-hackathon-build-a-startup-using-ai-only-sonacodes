# Backend (copy to backend/.env)
DATABASE_URL=postgresql+psycopg://sbos:sbos@localhost:5432/sbos
TEST_DATABASE_URL=postgresql+psycopg://sbos:sbos@localhost:5432/sbos_test
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
CORS_ORIGINS=http://localhost:3000

# Optional: attach seed data to an existing Auth user
SEED_USER_ID=

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
